*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
cleanup_report_before.txt
cleanup_report_after.txt

# Excel temporary files
~$*.xlsx
.~lock.*

# Benchmark test outputs (ignore temporary smoke tests)
outputs/benchmark/smoke_test/
outputs/benchmark/cleanup_smoke_test/
outputs/benchmark/test_run/
outputs/benchmarks/benchmark_*

# Keep production and official benchmark outputs
!outputs/production/
!outputs/datasets/
!outputs/benchmark/official_v1_30seeds_soft35/
