# ==========================================
# GA Timetabling System - Environment Config
# ==========================================

# GA Engine Hyperparameters
POP_SIZE=60
GENERATIONS=100
CROSSOVER_RATE=0.8
MUTATION_RATE=0.2

# Fitness Penalty Weights
HARD_WEIGHT=1000
SOFT_WEIGHT=1

# Repair Engine Configuration
USE_REPAIR=True

# Benchmark & Visualization Options
OUTPUT_PLOT_PATH=evaluation/convergence_comparison.png

# Python Runtime Settings
PYTHONUNBUFFERED=1
